# Copy to .env and change values. Never commit .env.
POSTGRES_USER=exambase
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=exambase
# Required: random string, 32+ chars. Generate with: openssl rand -hex 32
JWT_SECRET=

# Step 32: AI gateway (Gemini). Leave empty to keep AI off. Pick the model id yourself from Google's current list.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=60000
AI_GLOBAL_DAILY_TOKEN_LIMIT=2000000

# Production email delivery (required in APP_ENV=production). Use provider-issued SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Set to true ONLY behind your own reverse proxy (nginx, load balancer) so rate limits use the real client IP.
TRUST_PROXY=false
